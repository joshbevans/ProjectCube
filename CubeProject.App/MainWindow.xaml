<Window x:Class="CubeProject.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:vm="clr-namespace:CubeProject.App.ViewModels"
        Title="Cube Project" Height="720" Width="1200"
        Background="#1A1A1A" WindowStyle="SingleBorderWindow">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Main content area -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Collapsible loadout panel -->
                <ColumnDefinition Width="{Binding LoadoutPanelWidth}" MinWidth="0" />
                <ColumnDefinition Width="4" />
                <!-- 3D viewport -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Loadout panel -->
            <Border Grid.Column="0" Background="#222222" Visibility="{Binding LoadoutPanelVisible}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2A2A2A" Padding="8,6">
                        <DockPanel>
                            <TextBlock Text="LOADOUTS" Foreground="#888888" FontSize="11"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="⟳" Width="24" Height="24"
                                    Command="{Binding RefreshCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#AAAAAA" FontSize="14"
                                    ToolTip="Reload from disk" />
                        </DockPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Loadouts}"
                             SelectedItem="{Binding SelectedLoadout}"
                             Background="Transparent" BorderThickness="0"
                             Margin="0,4,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,4">
                                    <TextBlock Text="{Binding Name}" Foreground="#DDDDDD" FontSize="13" />
                                    <TextBlock Text="{Binding Mode}" Foreground="#666666" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#333366" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A2A3A" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#333333" Visibility="{Binding LoadoutPanelVisible}" />

            <!-- 3D Viewport -->
            <Border Grid.Column="2" Background="#111111">
                <h:HelixViewport3D x:Name="Viewport"
                                   Background="#111111"
                                   ShowCoordinateSystem="False"
                                   ShowFrameRate="False"
                                   ZoomExtentsWhenLoaded="True">
                    <h:HelixViewport3D.Camera>
                        <PerspectiveCamera Position="30,30,30" LookDirection="-1,-1,-1"
                                           UpDirection="0,1,0" FieldOfView="45" />
                    </h:HelixViewport3D.Camera>

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <AmbientLight Color="#404040" />
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <DirectionalLight Color="White" Direction="-1,-2,-1" />
                        </ModelVisual3D.Content>
                    </ModelVisual3D>

                    <!-- Cube geometry injected from code-behind -->
                    <ModelVisual3D x:Name="CubeVisual" />
                </h:HelixViewport3D>
            </Border>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <!-- Toggle loadout panel -->
                <Button DockPanel.Dock="Left" Content="☰" Width="32" Height="28"
                        Command="{Binding ToggleLoadoutPanelCommand}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#AAAAAA" FontSize="16" ToolTip="Toggle loadout panel" />

                <!-- Active loadout name -->
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0"
                           Text="{Binding ActiveLoadoutLabel}" Foreground="#CCCCCC" FontSize="13" />

                <!-- Right side -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Connection status -->
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="#666666"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Settings button -->
                    <Button Content="⚙" Width="32" Height="28"
                            Command="{Binding OpenSettingsCommand}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#AAAAAA" FontSize="16" ToolTip="Settings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Settings overlay -->
        <Grid Grid.RowSpan="2" Visibility="{Binding SettingsOverlayVisible}"
              Background="#80000000">
            <Border Background="#252525" BorderBrush="#444444" BorderThickness="1"
                    CornerRadius="8" Width="420" MaxHeight="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="Settings" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28"
                                Command="{Binding CloseSettingsCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#AAAAAA" FontSize="14" />
                    </DockPanel>

                    <Separator Background="#333333" Margin="0,0,0,16" />

                    <!-- Audio device -->
                    <TextBlock Text="Audio Channel" Foreground="#888888" FontSize="11"
                               FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding AudioDevices}"
                              SelectedItem="{Binding SelectedAudioDevice}"
                              DisplayMemberPath="FriendlyName"
                              Background="#333333" Foreground="White"
                              BorderBrush="#444444" Height="32" />
                    <TextBlock Text="Select the audio output to react to (WASAPI loopback)"
                               Foreground="#555555" FontSize="11" Margin="0,4,0,16" />

                    <Button Content="Save" Command="{Binding SaveSettingsCommand}"
                            HorizontalAlignment="Right" Width="80" Height="32"
                            Background="#3355AA" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
